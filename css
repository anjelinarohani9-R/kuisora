/* Tema dasar & tipografi ACHIEVQUIZ */
body {
font-family: 'Inter', sans-serif;
background-color: #FFF0F5;
color: #333333;
overflow-x: hidden;
-webkit-tap-highlight-color: transparent;
}

h1, h2, h3, .font-display {
font-family: 'Fredoka', sans-serif;
}

/* Scrollbar pastel kustom */
::-webkit-scrollbar {
width: 6px;
}

::-webkit-scrollbar-track {
background: #FFF0F5;
}

::-webkit-scrollbar-thumb {
background: #FFB6C1;
border-radius: 10px;
}

/* Animasi melayang halus untuk ikon hasil/piala */
@keyframes float {
0%, 100% { transform: translateY(0px); }
50% { transform: translateY(-6px); }
}

.animate-float {
animation: float 3s ease-in-out infinite;
}

/* Animasi karakter pelari pada Quiz Runner */
@keyframes bounce-run {
0%, 100% { transform: translateY(0) scale(1); }
50% { transform: translateY(-5px) scale(1.05); }
}

.animate-run {
animation: bounce-run 0.4s infinite;
}

/* Efek balik kartu 3D untuk Flashcard */
.perspective-1000 {
perspective: 1000px;
}

.transform-style-3d {
transform-style: preserve-3d;
transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
}

.backface-hidden {
backface-visibility: hidden;
}

.rotate-y-180 {
transform: rotateY(180deg);
}

/* Orientasi layar terbalik 180 derajat untuk Pemain 2 Tarik Tambang */
.rotate-180-player {
transform: rotate(180deg);
}

/* Transisi putaran roda keberuntungan Spin & Dare */
.wheel-transition {
transition: transform 3s cubic-bezier(0.17, 0.67, 0.12, 0.99);
}
